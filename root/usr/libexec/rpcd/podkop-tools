#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
set -eu
case "$1" in
list)
    printf '%s\n' '{"source":{"url":""},"status":{"token":""},"seed":{},"fetch":{},"apply":{"version":""},"select":{"id":""},"speed":{"id":""},"latency":{"id":""},"service":{"id":""},"batch":{"ids":[],"kinds":[],"speed_bytes":0,"token":""},"cancel":{"token":""},"schedule":{}}'
    ;;
call)
    case "$2" in
        status)
            token=$(jq -r '.token // ""' 2>/dev/null)
            case "$token" in '' ) ;; *[!a-f0-9]* ) exit 2 ;; *) [ "${#token}" -eq 64 ] ;; esac
            exec /usr/libexec/podkop-tools/task status "$token" ;;
        cancel)
            token=$(jq -er '.token | select(type == "string" and length == 64)' 2>/dev/null)
            case "$token" in *[!a-f0-9]*) exit 2 ;; esac
            exec /usr/libexec/podkop-tools/task cancel "$token" ;;
        batch)
            request=$(jq -ce '{ids,kinds,speed_bytes,token} | select((.ids|type)=="array" and (.ids|length)>0 and (.ids|length)<=128 and (.kinds|type)=="array" and (.kinds|length)>0 and (.kinds|length)<=3 and (.token|type)=="string" and (.token|length)==64)' 2>/dev/null)
            [ "${#request}" -le 16384 ]
            token=$(printf '%s' "$request" | jq -r '.token')
            case "$token" in *[!a-f0-9]*) exit 2 ;; esac
            set -- batch "$request"
            ;;
        source) exec /usr/libexec/podkop-tools/task source ;;
        schedule) /etc/init.d/podkop-tools reload >/dev/null 2>&1; printf '{"ok":true}\n'; exit ;;
        seed|fetch) set -- "$2" ;;
        apply)
            version=$(jq -er '.version | select(type=="string" and length==64)' 2>/dev/null)
            case "$version" in *[!a-f0-9]*) exit 2 ;; esac
            set -- apply "$version"
            ;;
        select|speed|latency|service)
            id=$(jq -er '.id | select(type=="string" and length==64)' 2>/dev/null)
            case "$id" in *[!a-f0-9]*) exit 2 ;; esac
            set -- "$2" "$id"
            ;;
        *) exit 2 ;;
    esac
    nohup /usr/libexec/podkop-tools/task "$@" >/dev/null 2>&1 </dev/null &
    printf '{"ok":true,"queued":true}\n'
    ;;
*) exit 2 ;;
esac
