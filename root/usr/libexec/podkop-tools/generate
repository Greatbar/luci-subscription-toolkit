#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
set -e
job=/tmp/podkop-tools/job
# Source the hash-verified installed implementation, stopping before its CLI.
awk '/^case "\$1" in/ {exit} {print}' /usr/bin/podkop > "$job/functions.sh"
(
    . "$job/functions.sh"
    # /lib/config/uci.sh resets this variable when sourced. Set it AFTER imports.
    UCI_CONFIG_DIR="$job/uci"
    config_load podkop
    config_get config_path settings config_path
    [ "$config_path" = "$job/generated.json" ]
    for section in $CONFIG_SECTIONS; do
        case "$section" in settings|main) continue;; esac
        config_get type "$section" TYPE
        config_get connection "$section" connection_type
        if [ "$section" = antigravity ]; then
            config_get kind "$section" proxy_config_type
            config_get node_id "$section" subscription_node_id
            [ "$type" = section ] && [ "$connection" = proxy ] && [ "$kind" = outbound ] && [ "${#node_id}" -eq 64 ] || exit 1
            case "$node_id" in *[!a-f0-9]*) exit 1;; esac
            continue
        fi
        [ "$type" = section ] && [ "$connection" = exclusion ] || exit 1
    done
    TMP_RULESET_FOLDER="$job/rulesets"
    rm -f "$TMP_RULESET_FOLDER"/*
    sing_box_init_config
) >/dev/null 2>&1
test -s "$job/generated.json"
