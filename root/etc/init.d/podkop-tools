#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
START=100
USE_PROCD=1

reload_service() {
    local enabled hours minutes old
    enabled=$(uci -q get podkop_tools.main.enabled) || enabled=0
    hours=$(uci -q get podkop_tools.main.fetch_hours) || hours=6
    minutes=$(uci -q get podkop_tools.main.health_minutes) || minutes=15
    case "$hours" in 1|2|3|4|6|8|12|24) ;; *) return 1;; esac
    case "$minutes" in 5|10|15|20|30|60) ;; *) return 1;; esac
    old=$(crontab -l 2>/dev/null || :)
    {
        printf '%s\n' "$old" | sed '/# podkop-tools$/d'
        if [ "$enabled" = 1 ]; then
            printf '23 */%s * * * /usr/libexec/podkop-tools/task check >/dev/null 2>&1 # podkop-tools\n' "$hours"
            printf '*/%s * * * * /usr/libexec/podkop-tools/task health >/dev/null 2>&1 # podkop-tools\n' "$minutes"
            printf '43 * * * * /usr/libexec/podkop-tools/task due >/dev/null 2>&1 # podkop-tools\n'
        fi
    } | crontab -
}
start_service() {
    reload_service || return 1
    [ "$(uci -q get podkop_tools.main.enabled)" = 1 ] || return 0
    # Finite boot job only; no respawn and no permanent controller.
    procd_open_instance restore
    procd_set_param command /usr/libexec/podkop-tools/boot
    procd_set_param stdout 0
    procd_set_param stderr 0
    procd_close_instance
}
stop_service() {
    local old
    old=$(crontab -l 2>/dev/null || :)
    printf '%s\n' "$old" | sed '/# podkop-tools$/d' | crontab -
}
service_triggers() { procd_add_reload_trigger podkop_tools; }
