config tools 'main'
    option enabled '0'
    option fetch_hours '6'
    option health_minutes '15'
    option pending_max_age_hours '12'
    option apply_policy 'manual'
    option apply_hour '3'
    option defer_hours '6'
    option max_defer_hours '24'
    option priority_recovery '1'
    option fallback_id ''
    option bootstrap_dns '77.88.8.8'
    option bootstrap_port '53'
    option health_url 'https://www.gstatic.com/generate_204'
    option speed_url 'https://speed.cloudflare.com/__down?bytes={bytes}'
    option speed_bytes '4194304'
    option speed_seconds '6'

 option service_url 'https://web.telegram.org/k/'
 option service_status '200'
 option service_content_type 'text/html'
 list service_markers '<title>Telegram Web</title>'
 list service_markers 'content="https://web.telegram.org/k/"'
 list service_markers '<script type="module"'
